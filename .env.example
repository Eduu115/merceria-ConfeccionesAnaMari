# Entorno de desarrollo. Copia este archivo a .env y ajusta los valores.

# --- Aplicación ---
NODO_ENTORNO=desarrollo
PUERTO=3010
ORIGEN_PUBLICO=http://localhost:5173
SERVIR_ESTATICOS=false

# --- PostgreSQL ---
DATABASE_URL=postgres://anamari:anamari@localhost:5434/anamari
POSTGRES_USER=anamari
POSTGRES_PASSWORD=anamari
POSTGRES_DB=anamari

# --- Sesión ---
SESION_SECRETO=cambia-este-secreto-en-produccion

# --- Primer usuario (propietario). Solo lo usa la semilla. ---
ADMIN_EMAIL=ana@confeccionesanamari.es
ADMIN_NOMBRE=Ana Mari
ADMIN_PASSWORD=cambia-esta-clave

# --- Correo (opcional en local) ---
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
CORREO_DESTINO=hola@confeccionesanamari.es

# --- Sitio ---
WHATSAPP_TELEFONO=34615644940
MAPA_EMBED_URL=https://www.google.com/maps?q=Calle+Almagro+15,+28904+Getafe&output=embed

# --- Archivos ---
RUTA_SUBIDAS=./datos/subidas
RUTA_PUBLICO=../web/dist
RUTA_COPIAS=./datos/copias

# --- Producción (docker compose prod) ---
DOMINIO=confeccionesanamari.es
